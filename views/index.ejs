<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Student Management</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="header"><h1>Student Records Portal</h1></div>

  <div class="container">
    <div class="toolbar">
      <form action="/students/search" method="GET">
        <input type="text" name="keyword" placeholder="Search student...">
        <button type="submit" class="btn">Search</button>
      </form>
      <a href="/students/add" class="btn">Add Student</a>
    </div>

    <div class="table-wrap">
      <table>
        <tr>
          <th>ID</th>
          <th>Student ID</th>
          <th>Name</th>
          <th>Course</th>
          <th>Year</th>
          <th>Email</th>
          <th>Action</th>
        </tr>
        <% if (students.length === 0) { %>
        <tr><td colspan="7" class="empty">No matching record</td></tr>
        <% } %>
        <% students.forEach(student => { %>
        <tr>
          <td><%= student.id %></td>
          <td><%= student.student_id %></td>
          <td><%= student.first_name %> <%= student.last_name %></td>
          <td><%= student.course %></td>
          <td><%= student.year_level %></td>
          <td><%= student.email %></td>
          <td>
            <form action="/students/delete/<%= student.id %>" method="POST"
                  onsubmit="return confirm('Delete this student?');">
              <button type="submit" class="btn btn-danger">Delete</button>
            </form>
          </td>
        </tr>
        <% }); %>
      </table>
    </div>
  </div>
</body>
</html>